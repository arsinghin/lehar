{
  "name": "lehar",
  "version": "1.0.0",
  "private": true,
  "description": "Lehar (लहर): an open-source GenAI celebration and event planner for India, where one change ripples through budget, timeline and vendors, and the host stays in control.",
  "author": "AR Singh (https://github.com/arsinghin)",
  "homepage": "https://github.com/arsinghin/lehar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsinghin/lehar.git"
  },
  "bugs": {
    "url": "https://github.com/arsinghin/lehar/issues"
  },
  "keywords": [
    "event-planner",
    "wedding",
    "celebration",
    "india",
    "gemini",
    "genai",
    "react",
    "vercel"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run check:secrets && npm run build && npm run check:size"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
