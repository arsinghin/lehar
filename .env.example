# Copy to .env.local for `vercel dev`. In production, set these in
# Vercel → Project → Settings → Environment Variables. They are read only by
# server code in /api and /server. Never prefix them with VITE_, because Vite
# would ship VITE_* variables to the browser.

# Google AI Studio key from a project WITHOUT a billing account (free tier only).
GEMINI_API_KEY=

# Optional. Comma-separated, tried in order. Only Gemini Flash / Flash-Lite and Gemma ids are accepted.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Optional fallback provider. Keep the OpenRouter balance at $0.
OPENROUTER_API_KEY=

# Optional. Comma-separated. Only ids ending in ":free" (or "openrouter/free") are accepted.
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free

# Optional. "off" (default, fastest) or "low" for models that require reasoning, such as gpt-oss.
OPENROUTER_REASONING=off

# Optional fallback after OpenRouter: a free NVIDIA Developer Program key from build.nvidia.com.
NVIDIA_API_KEY=

# Optional. Comma-separated NVIDIA catalog ids. Use models marked "Free Endpoint".
NVIDIA_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional. Extra origins allowed to call /api (the deployment's own origin is always allowed).
ALLOWED_ORIGINS=
